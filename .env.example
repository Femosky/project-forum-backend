# Copy to .env and fill in. The server refuses to start if these are missing or invalid.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Optional direct (non-pooled) connection for the job queue, e.g. Neon's non "-pooler" host
# DIRECT_DATABASE_URL=""
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=""
# Comma-separated web origins allowed to call the API (CORS)
WEB_ORIGIN="http://localhost:3000"
# Base URL for links in emails; defaults to the first WEB_ORIGIN
# WEB_URL="https://forum.oskeylabs.com"
# Only needed when the web app and API are on different subdomains, e.g. .oskeylabs.com
# COOKIE_DOMAIN=".oskeylabs.com"
# NODE_ENV="production"
# PORT=3001
# LOG_LEVEL="info"

# Rate limits: "postgres" (default, holds across instances) or "memory"
# RATE_LIMIT_STORE="postgres"
# Background jobs on Postgres via pg-boss; "false" runs them inline in the request
# JOBS_ENABLED="true"
# LINK_PREVIEWS_ENABLED="true"

# Email via Resend (free tier). Without a key, emails are logged instead of sent.
# RESEND_API_KEY=""
# EMAIL_FROM="Project Forum <no-reply@forum.oskeylabs.com>"

# Google sign-in (OAuth client id from Google Cloud console). Without it, /v1/auth/google answers 503.
# GOOGLE_CLIENT_ID=""

# Cloudflare Turnstile secret. Without it, challenges are skipped.
# TURNSTILE_SECRET_KEY=""

# IndexNow ping for new posts (Bing, Yandex). Any 8-128 letters/digits; set the same value in the web app.
# INDEXNOW_KEY=""
