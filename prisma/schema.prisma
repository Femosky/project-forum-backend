// Schema v2 (Phase 2 of docs/ROADMAP.md). Everything below is one baseline migration.
// Conventions:
// - UUIDv7 primary keys (time-ordered, good index locality); 8-char short_id for URLs.
// - Counters (votes, comments, members) are denormalised and updated in the same transaction as the write.
// - One `status` per piece of content; who/why/when of moderation lives in ModAction.
// - Search columns (tsvector) and trigram indexes are created in raw SQL in the migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, citext]
}

/**
 * Enums
 */

enum UserStatus {
  active
  suspended
  banned
  deleted
}

enum UserRole {
  user
  admin
}

enum CommunityStatus {
  active
  archived
  deleted
}

enum CommunityVisibility {
  public
  private
}

enum MemberRole {
  member
  moderator
  owner
}

enum ContentStatus {
  active
  pending
  locked
  removed
  deleted
}

enum PostType {
  text
  link
  image
}

enum TokenPurpose {
  verify_email
  reset_password
  change_email
}

enum ReportTargetType {
  post
  comment
  user
  community
  ad
}

enum ReportReason {
  spam
  scam
  personal_info
  harassment
  hate
  violence
  sexual
  self_harm
  misinformation
  illegal
  impersonation
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
}

enum CampaignStatus {
  draft
  active
  paused
  ended
}

enum AdFormat {
  feed_post
  thread_comment
  // Both places: the big card in feeds, the compact one between comments
  any
}

// How an ad's picture fills its 1.91:1 frame: cropped around a focal point, or shown whole on a blurred copy of itself
enum AdImageFit {
  cover
  contain
}

// direct: a paying advertiser. house: the site's own promotions, shown when no direct campaign fills a slot.
enum CampaignKind {
  direct
  house
}

// cpm: budget is spent per thousand viewable impressions. flat: a fixed fee for the campaign's dates.
enum PricingModel {
  cpm
  flat
}

/**
 * Users and auth
 */

model User {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  username          String    @unique
  email             String    @unique
  // Null for accounts that only sign in with Google
  password_hash     String?
  google_id         String?   @unique
  email_verified_at DateTime?

  display_name  String?
  avatar_id     String  @default("default_1")
  // Drawn avatar parts (lib/avatars.ts); null = derived from the account id
  avatar_config Json?

  role   UserRole   @default(user)
  status UserStatus @default(active)

  // Users confirm they are 18+ at signup; we keep the time of the attestation, not a birth date
  adult_attested_at DateTime?
  // Show posts and communities marked mature (NSFW) in feeds, search and the directory, without the blur. Off by
  // default; guests never see them there
  show_mature       Boolean   @default(false)

  karma          Int       @default(0)
  // Marked trusted by the site's admins: skips the new-account limits (links and pictures on the first day, hourly
  // posting caps). Every content check still applies. Shown in the admin panel only
  is_trusted     Boolean   @default(false)
  last_login_at  DateTime?
  // Last request as a signed-in user, written at most every 15 minutes (lib/activity.ts)
  last_active_at DateTime?

  // Site-admin actions. A suspension with no end date is permanent; an expired one is lifted at the next sign-in.
  suspended_until          DateTime?
  suspension_reason        String?
  // Shadow-banned accounts see their own posts and comments; nobody else does (see shadow_hidden on content)
  shadow_banned_at         DateTime?
  notification_preferences Json?
  last_reply_email_at      DateTime?
  digest_last_sent_at      DateTime?
  // Digests sent in a row with no visit afterwards
  digest_unopened          Int       @default(0)
  last_trending_push_at    DateTime?

  sessions            Session[]
  verification_tokens VerificationToken[]

  posts          Post[]
  comments       Comment[]
  post_votes     PostVote[]
  comment_votes  CommentVote[]
  saved_posts    SavedPost[]
  saved_comments SavedComment[]

  created_communities Community[]            @relation("created_communities")
  memberships         CommunityMember[]
  join_requests       CommunityJoinRequest[] @relation("join_requester")
  push_subscriptions  PushSubscription[]
  mod_invites         ModInvite[]            @relation("mod_invitee")
  mod_invites_sent    ModInvite[]            @relation("mod_inviter")
  mod_email_settings  ModEmailSetting[]
  join_responses      CommunityJoinRequest[] @relation("join_responder")

  blocked_users Block[] @relation("blocker")
  blocked_by    Block[] @relation("blocked")

  reports_sent     Report[]    @relation("reporter")
  reports_resolved Report[]    @relation("resolver")
  mod_actions      ModAction[]

  notifications      Notification[] @relation("notification_recipient")
  notifications_sent Notification[] @relation("notification_actor")

  mutes         CommunityMute[]   @relation("muted_user")
  mutes_given   CommunityMute[]   @relation("muted_by")
  blocked_terms BlockedTerm[]
  active_days   DailyActiveUser[]

  @@index([status])
  @@index([last_active_at])
  @@index([username(ops: raw("gin_trgm_ops"))], map: "User_username_trgm_idx", type: Gin)
}

// One row per signed-in device. Stores a hash of the current refresh token; rotated on every refresh.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  refresh_token_hash  String
  // The previous hash is kept briefly so two tabs refreshing at once are not treated as token theft
  previous_token_hash String?
  rotated_at          DateTime?

  expires_at   DateTime
  last_used_at DateTime  @default(now())
  revoked_at   DateTime?

  user_agent  String?
  browser     String?
  os          String?
  device_type String?
  ip_address  String?
  country     String?
  city        String?

  @@index([user_id, revoked_at])
  @@index([expires_at])
}

model VerificationToken {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  purpose    TokenPurpose
  token_hash String       @unique
  // For change_email: the address being moved to
  new_email  String?
  expires_at DateTime
  used_at    DateTime?

  @@index([user_id, purpose])
}

model Block {
  created_at DateTime @default(now())

  blocker_id String @db.Uuid
  blocker    User   @relation("blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_id String @db.Uuid
  blocked    User   @relation("blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@id([blocker_id, blocked_id])
  @@index([blocked_id])
}

/**
 * Communities
 */

model Community {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // The URL key: 3-21 lowercase letters and digits, never changes (/c/premierleague). citext, so lookups in any case
  // find it; old names (CommunityAlias) redirect to it.
  name         String              @unique @db.Citext
  // The same letters with the capitals the community chose ("PremierLeague"), shown as the handle; null = name
  name_styled  String?
  display_name String?
  description  String?
  image_url    String?
  // 4:1 header picture
  banner_url   String?
  rules        Json?
  // One of COMMUNITY_CATEGORIES (src/shared/validation.ts), for the directory
  category     String?
  status       CommunityStatus     @default(active)
  visibility   CommunityVisibility @default(public)
  is_nsfw      Boolean             @default(false)
  // null follows the default (no ads in sensitive categories); true/false is an admin's override
  ads_enabled  Boolean?

  created_by     String @db.Uuid
  created_by_ref User   @relation("created_communities", fields: [created_by], references: [id])

  member_count Int @default(0)
  post_count   Int @default(0)

  // Generated tsvector over name + description (raw SQL in the migration)
  search_vector Unsupported("tsvector")?

  members       CommunityMember[]
  // No owner or moderator left to run it: shown to the site's admins
  needs_moderator Boolean @default(false)

  join_requests CommunityJoinRequest[]
  mod_invites   ModInvite[]
  mod_email_settings ModEmailSetting[]
  notifications Notification[]
  mutes         CommunityMute[]
  posts         Post[]
  flairs        Flair[]
  mod_actions   ModAction[]
  reports       Report[]

  aliases         CommunityAlias[]
  trending        TrendingCommunity[]
  trending_topics TrendingTopic[]
  daily_visitors  CommunityDailyVisitor[]
  daily_traffic   CommunityDailyTraffic[]
  daily_stats     CommunityDailyStat[]
  // Plus a trigram GIN index on name for autocomplete (raw SQL in the migration)

  @@index([status, member_count(sort: Desc)])
  @@index([category, member_count(sort: Desc)])
  @@index([search_vector], type: Gin)
}

// Membership, moderator role and bans in one table
model CommunityMember {
  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user_id      String    @db.Uuid
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  role      MemberRole @default(member)
  // What a moderator may do: lead (also manages moderators), all, or posts only (the queue and reports)
  mod_permission ModPermission @default(all)
  joined_at DateTime   @default(now())

  // A banned user keeps their row so the ban sticks if they try to rejoin; null until means permanent
  is_banned    Boolean   @default(false)
  banned_until DateTime?
  ban_reason   String?

  @@id([community_id, user_id])
  @@index([user_id])
  @@index([community_id, role])
}

// A muted user can still read (and stay a member) but can't post or comment in the community until the mute ends.
// Separate from CommunityMember because people who never joined can still post in public communities.
model CommunityMute {
  created_at DateTime @default(now())

  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user_id      String    @db.Uuid
  user         User      @relation("muted_user", fields: [user_id], references: [id], onDelete: Cascade)

  muted_until DateTime
  reason      String?
  muted_by    String   @db.Uuid
  muter       User     @relation("muted_by", fields: [muted_by], references: [id])

  @@id([community_id, user_id])
  @@index([user_id])
}

model CommunityJoinRequest {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user_id      String    @db.Uuid
  user         User      @relation("join_requester", fields: [user_id], references: [id], onDelete: Cascade)

  message      String?
  status       JoinRequestStatus @default(pending)
  responded_by String?           @db.Uuid
  responder    User?             @relation("join_responder", fields: [responded_by], references: [id])
  responded_at DateTime?

  @@unique([community_id, user_id])
  @@index([community_id, status])
}

model Flair {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)

  name  String
  color String?

  posts Post[]

  @@unique([community_id, name])
}

/**
 * Content
 */

model Post {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  short_id String @unique
  slug     String

  author_id    String    @db.Uuid
  author       User      @relation(fields: [author_id], references: [id])
  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id])

  type         PostType @default(text)
  title        String
  body         String   @default("")
  url          String?
  // The url with tracking parameters, fragment, "www." and trailing slash removed, for duplicate checks
  url_key      String?
  // { title, description, image, site } filled in by the link-preview job
  link_preview Json?
  // Picture posts: { url, width, height, variants: [{ url, width, height }] }, uploaded to our storage (never hotlinked),
  // redrawn without EXIF or location data and checked before it can be posted
  image        Json?
  ai_summary   String?

  is_anonymous Boolean @default(false)
  is_nsfw      Boolean @default(false)
  // Only site admins set this (ads, Phase 6)
  is_sponsored Boolean @default(false)

  flair_id String? @db.Uuid
  flair    Flair?  @relation(fields: [flair_id], references: [id], onDelete: SetNull)

  status          ContentStatus @default(active)
  edited_at       DateTime?
  pinned_at       DateTime?
  // Why the automatic filters held this post for review (status pending); shown to moderators only
  held_reason     String?
  // Held for the site's admins only (sexual content, or worse): community moderators can't approve it
  held_for_admins Boolean       @default(false)
  // Written by a shadow-banned account: only the author sees it
  shadow_hidden   Boolean       @default(false)

  upvote_count   Int   @default(0)
  // Times a person (not a bot, not the author) opened it; shown to the author only
  view_count     Int   @default(0)
  downvote_count Int   @default(0)
  score          Int   @default(0)
  comment_count  Int   @default(0)
  hot_rank       Float @default(0)

  search_vector Unsupported("tsvector")?

  comments      Comment[]
  votes         PostVote[]
  saves         SavedPost[]
  notifications Notification[]
  trending      TrendingPost[]

  // Feed indexes. Status is left out on purpose: almost every post is listed, so scanning in rank order and
  // filtering status (and community visibility) stops after one page, while a status column in the index
  // (filtered with IN) would force a sort.
  @@index([url_key, created_at(sort: Desc)])
  @@index([community_id, hot_rank(sort: Desc), id(sort: Desc)])
  @@index([community_id, created_at(sort: Desc), id(sort: Desc)])
  @@index([community_id, score(sort: Desc), id(sort: Desc)])
  @@index([hot_rank(sort: Desc), id(sort: Desc)])
  @@index([created_at(sort: Desc), id(sort: Desc)])
  @@index([author_id, created_at(sort: Desc)])
  @@index([search_vector], type: Gin)
  // The mod queue's held posts
  @@index([community_id, status])
}

model Comment {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  short_id String @unique

  author_id String @db.Uuid
  author    User   @relation(fields: [author_id], references: [id])
  post_id   String @db.Uuid
  post      Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)

  // Tree: parent, top-level ancestor, depth (0 = top level) and a materialised path of short ids
  parent_id String?   @db.Uuid
  parent    Comment?  @relation("replies", fields: [parent_id], references: [id])
  replies   Comment[] @relation("replies")
  root_id   String?   @db.Uuid
  depth     Int       @default(0)
  path      String

  body            String
  is_anonymous    Boolean       @default(false)
  is_sponsored    Boolean       @default(false)
  status          ContentStatus @default(active)
  edited_at       DateTime?
  pinned_at       DateTime?
  held_reason     String?
  // Held for the site's admins only (sexual content, or worse): community moderators can't approve it
  held_for_admins Boolean       @default(false)
  shadow_hidden   Boolean       @default(false)

  upvote_count   Int   @default(0)
  // Times its thread was opened with this comment on screen (not by a bot or the author); author only
  view_count     Int   @default(0)
  downvote_count Int   @default(0)
  score          Int   @default(0)
  reply_count    Int   @default(0)
  // Wilson score lower bound, for "best" sort
  best_rank      Float @default(0)

  // Generated tsvector over the body (raw SQL in the migration)
  search_vector Unsupported("tsvector")?

  votes         CommentVote[]
  saves         SavedComment[]
  notifications Notification[]

  @@index([post_id, depth, best_rank(sort: Desc), id(sort: Desc)])
  @@index([post_id, depth, created_at(sort: Desc), id(sort: Desc)])
  @@index([parent_id, best_rank(sort: Desc), id(sort: Desc)])
  @@index([root_id, path])
  @@index([author_id, created_at(sort: Desc)])
  @@index([search_vector], type: Gin)
  // The mod queue's held comments
  @@index([status, post_id])
}

// One row per user per item; changing a vote is an upsert
model PostVote {
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id    String   @db.Uuid
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  value      Int      @db.SmallInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@id([user_id, post_id])
  @@index([post_id])
}

model CommentVote {
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comment_id String   @db.Uuid
  comment    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  value      Int      @db.SmallInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@id([user_id, comment_id])
  @@index([comment_id])
}

model SavedPost {
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id    String   @db.Uuid
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@id([user_id, post_id])
  @@index([user_id, created_at(sort: Desc)])
}

model SavedComment {
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comment_id String   @db.Uuid
  comment    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@id([user_id, comment_id])
  @@index([user_id, created_at(sort: Desc)])
}

/**
 * Moderation
 */

model Report {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  reporter_id String @db.Uuid
  reporter    User   @relation("reporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  target_type  ReportTargetType
  target_id    String           @db.Uuid
  // The community whose mod queue sees it; null for user/site-level reports
  community_id String?          @db.Uuid
  community    Community?       @relation(fields: [community_id], references: [id], onDelete: Cascade)

  reason_code       ReportReason
  note              String?
  status            ReportStatus  @default(open)
  resolved_by       String?       @db.Uuid
  resolver          User?         @relation("resolver", fields: [resolved_by], references: [id])
  resolved_by_staff String?       @db.Uuid
  staff_resolver    StaffAccount? @relation(fields: [resolved_by_staff], references: [id], onDelete: SetNull)
  resolved_at       DateTime?

  @@unique([reporter_id, target_type, target_id])
  @@index([community_id, status, created_at])
  @@index([target_type, target_id])
  @@index([status, created_at])
}

// Audit trail: every moderator or admin action
model ModAction {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  // A forum moderator, or a staff member acting from the admin panel
  actor_id     String?       @db.Uuid
  actor        User?         @relation(fields: [actor_id], references: [id], onDelete: Restrict)
  staff_id     String?       @db.Uuid
  staff        StaffAccount? @relation(fields: [staff_id], references: [id], onDelete: SetNull)
  community_id String?       @db.Uuid
  community    Community?    @relation(fields: [community_id], references: [id], onDelete: Cascade)

  // e.g. remove_post, approve_comment, lock_post, ban_user, set_role
  action      String
  target_type ReportTargetType
  target_id   String           @db.Uuid
  reason      String?
  details     Json?

  @@index([community_id, created_at(sort: Desc)])
  @@index([target_type, target_id])
  @@index([created_at(sort: Desc)])
}

enum BlockedTermKind {
  domain
  keyword
}

// Site-wide blocklist managed by admins. Posts and comments that match are held for review, not deleted.
model BlockedTerm {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  kind  BlockedTermKind
  // Lowercase; a domain also matches its subdomains, a keyword matches as a whole word or phrase
  value String
  note  String?

  created_by       String?       @db.Uuid
  creator          User?         @relation(fields: [created_by], references: [id], onDelete: Restrict)
  created_by_staff String?       @db.Uuid
  staff_creator    StaffAccount? @relation(fields: [created_by_staff], references: [id], onDelete: SetNull)

  @@unique([kind, value])
}

/**
 * Rate limiting (Postgres-backed, so limits hold across instances without Redis)
 */

model RateLimit {
  key      String   @id
  hits     Int
  reset_at DateTime

  @@index([reset_at])
}

/**
 * Ads (schema only; the ad server arrives in Phase 6). Money is stored in minor units with an explicit currency.
 */

model Advertiser {
  id            String   @id @default(uuid(7)) @db.Uuid
  created_at    DateTime @default(now())
  name          String
  contact_email String?
  logo_url      String?
  website       String?
  notes         String?

  campaigns Campaign[]
}

model Campaign {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  advertiser_id String     @db.Uuid
  advertiser    Advertiser @relation(fields: [advertiser_id], references: [id], onDelete: Cascade)

  name          String
  kind          CampaignKind   @default(direct)
  status        CampaignStatus @default(draft)
  starts_at     DateTime?
  ends_at       DateTime?
  // { communities?: string[], categories?: string[] } today; kept open so country targeting fits later.
  // Empty means every page that carries ads.
  targeting     Json?
  pricing_model PricingModel   @default(flat)
  // Money in minor units (kobo for NGN) with an explicit currency
  budget_minor  Int?
  // CPM rate, or the flat fee
  price_minor   Int?
  currency      String         @default("NGN")
  // Most times one viewer sees this campaign per day; null is no cap
  frequency_cap Int?
  // Higher wins among campaigns that target the same pages
  priority      Int            @default(0)
  // House campaigns only: percent of slots (0-50) this campaign takes even when paid campaigns want them, so the
  // site's own products get seen. 0 means it only fills slots nobody paid for.
  house_share   Int            @default(0)
  // Invoice tracking for direct deals (Paystack payment link)
  payment_url   String?
  paid_at       DateTime?
  // Secret for the advertiser's read-only stats page
  stats_token   String?        @unique

  creatives AdCreative[]

  @@index([status, starts_at])
}

model AdCreative {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  campaign_id String   @db.Uuid
  campaign    Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  updated_at DateTime @updatedAt

  format                AdFormat
  headline              String
  body                  String?
  image_url             String?
  // Where the picture's focus is (0-100 across and down) when it's cropped to the frame, and how it fills the frame
  image_focus_x         Int        @default(50)
  image_focus_y         Int        @default(50)
  image_fit             AdImageFit @default(cover)
  // With no picture: use the destination page's own preview image, copied into our storage (never hotlinked)
  use_link_image        Boolean    @default(true)
  link_image_url        String?
  link_image_checked_at DateTime?
  click_url             String
  cta_label             String     @default("Learn more")
  is_active             Boolean    @default(true)

  daily_stats AdDailyStat[]
}

model AdDailyStat {
  creative_id String     @db.Uuid
  creative    AdCreative @relation(fields: [creative_id], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  impressions Int        @default(0)
  clicks      Int        @default(0)

  @@id([creative_id, date])
}

/**
 * Notifications
 */

// A browser that said yes to notifications
model PushSubscription {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  user_id  String @db.Uuid
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  @@index([user_id])
}

enum ModPermission {
  all
  posts
  // Everything, including managing the other moderators
  lead
}

enum ModInviteStatus {
  pending
  accepted
  declined
  cancelled
}

// Asked to help moderate. The person accepts it themself, so nobody becomes a moderator without knowing.
model ModInvite {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user_id      String    @db.Uuid
  user         User      @relation("mod_invitee", fields: [user_id], references: [id], onDelete: Cascade)
  invited_by   String    @db.Uuid
  inviter      User      @relation("mod_inviter", fields: [invited_by], references: [id], onDelete: Cascade)

  permission ModPermission   @default(all)
  status     ModInviteStatus @default(pending)

  @@unique([community_id, user_id])
  @@index([user_id, status])
}

enum ModEmailFrequency {
  instant
  daily
  off
}

// How a moderator hears about one community by email. No row means the default, a daily digest.
model ModEmailSetting {
  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  user_id      String    @db.Uuid
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  frequency    ModEmailFrequency @default(daily)
  last_sent_at DateTime?

  @@id([community_id, user_id])
}

enum NotificationType {
  post_reply
  comment_reply
  mention
  // For a community's moderators; one unread row per community and type, with a running count
  mod_queue
  mod_report
  mod_join_request
  mod_invite
}

// In-app notifications. Replies and mentions point at the comment that caused them, one per recipient per comment;
// moderator notices point at the community instead.
model Notification {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())

  user_id  String  @db.Uuid
  user     User    @relation("notification_recipient", fields: [user_id], references: [id], onDelete: Cascade)
  // Kept even for anonymous comments (so blocks still apply); hidden when serialised
  actor_id String? @db.Uuid
  actor    User?   @relation("notification_actor", fields: [actor_id], references: [id], onDelete: SetNull)

  type       NotificationType
  post_id    String?          @db.Uuid
  post       Post?            @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment_id String?          @db.Uuid
  comment    Comment?         @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  community_id String?    @db.Uuid
  community    Community? @relation(fields: [community_id], references: [id], onDelete: Cascade)
  count        Int        @default(1)

  read_at    DateTime?
  emailed_at DateTime?

  @@unique([user_id, comment_id])
  @@index([user_id, created_at(sort: Desc), id(sort: Desc)])
  @@index([user_id, read_at])
  @@index([community_id, type, read_at])
}

// A community's earlier name; /c/{old name} redirects to the current one
model CommunityAlias {
  name         String    @id @db.Citext
  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  created_at   DateTime  @default(now())

  @@index([community_id])
}

/**
 * Discovery: trending snapshots (modules/trending) and the word list behind "Did you mean ...?"
 */

// Each table is replaced as a whole every 10 minutes; rank 1 is the top
model TrendingPost {
  rank        Int      @id
  post_id     String   @db.Uuid
  post        Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  score       Float
  // Distinct accounts that voted or replied in the window
  voters      Int
  repliers    Int
  computed_at DateTime

  @@index([post_id])
}

model TrendingCommunity {
  rank         Int       @id
  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  score        Float
  // Last 7 days
  new_members  Int
  posts        Int
  comments     Int
  computed_at  DateTime

  @@index([community_id])
}

model TrendingTopic {
  rank         Int        @id
  // 'term' (a word or two-word phrase from titles) or 'flair'
  kind         String
  term         String
  // The flair's community
  community_id String?    @db.Uuid
  community    Community? @relation(fields: [community_id], references: [id], onDelete: Cascade)
  posts        Int
  authors      Int
  score        Float
  computed_at  DateTime

  @@index([community_id])
}

model SearchWord {
  word String @id
  docs Int

  @@index([word(ops: raw("gin_trgm_ops"))], map: "SearchWord_word_trgm_idx", type: Gin)
}

/**
 * Site metrics (modules/metrics). Days are Lagos dates. Visitors are hashes, never IPs.
 */

model DailySalt {
  date DateTime @id @db.Date
  salt String
}

model DailyVisitor {
  date      DateTime @db.Date
  // sha256 of the day's salt, IP and user agent
  visitor   String
  // ISO country code when known
  country   String?
  signed_in Boolean  @default(false)

  @@id([date, visitor])
}

model CommunityDailyVisitor {
  date         DateTime  @db.Date
  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  visitor      String

  @@id([date, community_id, visitor])
}

model DailyActiveUser {
  date    DateTime @db.Date
  user_id String   @db.Uuid
  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([date, user_id])
}

model DailyTraffic {
  date       DateTime @id @db.Date
  page_views Int      @default(0)
}

model CommunityDailyTraffic {
  date         DateTime  @db.Date
  community_id String    @db.Uuid
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  page_views   Int       @default(0)

  @@id([date, community_id])
}

// Written nightly for the day before; Admin -> Stats reads these
model DailyStat {
  date              DateTime @id @db.Date
  total_users       Int
  new_signups       Int
  // Accounts active that day, in the 7 and 30 days up to it
  dau               Int
  wau               Int
  mau               Int
  // Guests included; bots excluded
  unique_visitors   Int
  page_views        Int
  posts             Int
  comments          Int
  votes             Int
  // Paid (direct) campaigns only; house ads are counted apart
  ad_impressions    Int
  ad_clicks         Int
  house_impressions Int      @default(0)
  house_clicks      Int      @default(0)
  // { "NG": 120, "GB": 8, ... } unique visitors by country, when known
  countries         Json?
  computed_at       DateTime @default(now())
}

model CommunityDailyStat {
  date            DateTime  @db.Date
  community_id    String    @db.Uuid
  community       Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  members         Int
  new_members     Int
  posts           Int
  comments        Int
  votes           Int
  unique_visitors Int
  page_views      Int

  @@id([date, community_id])
  @@index([community_id, date])
}

/**
 * Staff: admin panel accounts (modules/staff), separate from forum accounts
 */

// owner: everything, including staff accounts. admin: everything but staff accounts. ads: ads and stats.
// moderator: the site queue, users, communities, blocklist and logs.
enum StaffRole {
  owner
  admin
  ads
  moderator
}

model StaffAccount {
  id         String   @id @default(uuid(7)) @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  email              String    @unique @db.Citext
  name               String
  role               StaffRole @default(moderator)
  // Null until an invite is accepted
  password_hash      String?
  // Set by the bootstrap script: must be changed after the first sign-in
  password_temporary Boolean   @default(false)
  // Authenticator secret, encrypted (staff/totp.ts); enabled once a first code was entered
  totp_secret        String?
  totp_enabled_at    DateTime?
  // sha256 hashes of unused recovery codes
  recovery_codes     Json?
  disabled_at        DateTime?
  last_login_at      DateTime?

  created_by String?        @db.Uuid
  creator    StaffAccount?  @relation("staff_created", fields: [created_by], references: [id], onDelete: SetNull)
  created    StaffAccount[] @relation("staff_created")

  sessions      StaffSession[]
  tokens        StaffToken[]
  audit         StaffAudit[]
  mod_actions   ModAction[]
  reports       Report[]
  blocked_terms BlockedTerm[]
}

model StaffSession {
  id              String       @id @default(uuid(7)) @db.Uuid
  created_at      DateTime     @default(now())
  staff_id        String       @db.Uuid
  staff           StaffAccount @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  token_hash      String       @unique
  expires_at      DateTime
  last_used_at    DateTime     @default(now())
  // Null until the second step (authenticator code) is done; until then the session can only finish signing in
  mfa_verified_at DateTime?
  revoked_at      DateTime?
  ip_address      String?
  user_agent      String?

  @@index([staff_id])
}

model StaffToken {
  id         String       @id @default(uuid(7)) @db.Uuid
  created_at DateTime     @default(now())
  staff_id   String       @db.Uuid
  staff      StaffAccount @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  // 'invite'
  purpose    String
  token_hash String       @unique
  expires_at DateTime
  used_at    DateTime?

  @@index([staff_id])
}

model StaffAudit {
  id          String        @id @default(uuid(7)) @db.Uuid
  created_at  DateTime      @default(now())
  staff_id    String?       @db.Uuid
  staff       StaffAccount? @relation(fields: [staff_id], references: [id], onDelete: SetNull)
  action      String
  target_type String?
  target_id   String?
  details     Json?
  ip_address  String?

  @@index([created_at(sort: Desc)])
  @@index([staff_id, created_at(sort: Desc)])
}
